{
    "name": "bottimus",
    "author": "Robert A Fraser",
    "version": "2.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rafraser/bottimus.git"
    },
    "engines": {
        "node": ">=16.9.0"
    },
    "dependencies": {
        "discord.js": "^13.17.1",
        "dotenv": "^17.4.2",
        "html-entities": "^2.6.0",
        "mysql": "^2.18.1",
        "node-fetch": "^3.3.2",
        "prom-client": "^15.1.3"
    },
    "scripts": {
        "build": "tsc",
        "serve": "node dist/bottimus.js",
        "build-serve": "npm run build && npm run serve",
        "lint": "./node_modules/.bin/eslint --ext .ts",
        "flake8": "flake8 python --exit-zero --statistics --max-line-length=120 --ignore=E203",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/dotenv": "^8.2.3",
        "@types/html-entities": "^1.3.4",
        "@types/mysql": "^2.15.27",
        "@types/node-fetch": "^2.6.13",
        "@types/ws": "^8.18.1",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4"
    }
}
